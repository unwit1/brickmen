{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "body-generation-provider-registry.schema.json",
  "title": "Brickmen Body Generation Provider Registry",
  "type": "object",
  "required": [
    "schema_version",
    "verified_as_of",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "verified_as_of": {
      "type": "string"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider_id",
          "name",
          "role",
          "availability",
          "sources",
          "native_inputs",
          "native_outputs",
          "brickmen_integration",
          "pipeline_stage"
        ],
        "properties": {
          "provider_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "availability": {
            "type": "string"
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "object"
          },
          "native_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "native_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "native_controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hardware_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brickmen_integration": {
            "type": "object"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution": {
            "type": "object",
            "required": [
              "adapter_status",
              "entrypoint",
              "invocation"
            ],
            "properties": {
              "adapter_status": {
                "type": "string"
              },
              "entrypoint": {
                "type": "string"
              },
              "invocation": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "upstream_requirement_note": {
                "type": "string"
              }
            }
          },
          "pipeline_stage": {
            "type": "string",
            "enum": [
              "primary_generator",
              "articulated_generator",
              "post_generation_critic",
              "baseline_generator",
              "research_candidate"
            ]
          },
          "output_contract": {
            "type": "object"
          }
        }
      }
    }
  }
}

        "pair_id",
        "character_id",
        "from_architecture",
        "to_architecture"
      ],
      "fields": [
        "pair_id",
        "character_id",
        "appearance_id",
        "from_architecture",
        "to_architecture",
        "source_release_ids",
        "landmark_transform",
        "geometry_translation",
        "decoration_translation",
        "identity_features_preserved",
        "features_sculpted",
        "features_printed",
        "features_omitted",
        "accessory_scale_transform",
        "confidence",
        "sources"
      ]
    },
    "architecture_observation": {
      "required": [
        "observation_id",
        "target_release_or_component",
        "source_body_label",
        "observed_at"
      ],
      "fields": [
        "observation_id",
        "target_release_or_component",
        "source_body_label",
        "normalized_morphology",
        "architecture_candidate_id",
        "architecture_confidence",
        "evidence_kind",
        "dimensions",
        "component_observations",
        "joint_observations",
        "compatibility_observations",
        "physical_validation_state",
        "observed_at",
        "sources"
      ]
    }
  },
  "sculptural_depth_classes": [
    "silhouette_defining",
    "major_relief",
    "shallow_relief",
    "printed_only",
    "omit"
  ],
  "architecture_resolution_output": [
    "candidate_architectures",
    "confidence_distribution",
    "evidence",
    "unknown_probability",
    "recommended_next_evidence"
  ],
  "hard_rules": [
    "Never apply standard-minifigure decoration by uniform scaling to a non-standard body.",
    "Mechanical architecture and aesthetic maker/body style are separate concepts.",
    "Architecture-specific joints/connectors remain deterministic and empirically validated.",
    "Unknown architectures remain unknown until evidence supports classification."
  ]
}
{
  "schema_version": "0.1",
  "created": "2026-09-27",
  "purpose": "Represent architecture-conditioned body style and cross-architecture translation evidence.",
  "entities": {
    "body_style_profile": {
      "required": [
        "body_style_profile_id",
        "figure_architecture_id",
        "status"
      ],
      "fields": [
        "body_style_profile_id",
        "figure_architecture_id",
        "maker_scope",
        "era_scope",
        "sample_release_ids",
        "canonical_proportions",
        "landmarks",
        "geometry_vs_decoration_rules",
        "sculptural_depth_classes",
        "surface_schema_id",
        "decoration_density",
        "line_hierarchy",
        "face_scale_rules",
        "muscle_armor_rules",
        "base_color_rules",
        "negative_space_rules",
        "accessory_scale_rules",
        "validation_status",
        "sources"
      ]
    },
    "architecture_surface_schema": {
      "required": [
        "surface_schema_id",
        "figure_architecture_id",
        "surfaces"
      ],
      "fields": [
        "surface_schema_id",
        "figure_architecture_id",
        "surfaces",
        "uv_maps",
        "printable_regions",
        "curved_regions",
        "joint_contact_keepouts",
        "fixture_contact_zones",
        "seam_rules",
        "canonical_views",
        "sources"
      ]
    },
    "style_transfer_pair": {

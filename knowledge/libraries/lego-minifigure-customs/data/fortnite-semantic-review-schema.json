      "reviewer_type": "human|model|hybrid",
      "reviewer_id": "",
      "model_id": null,
      "model_revision": null,
      "review_role": "reviewer|adjudicator"
    },
    "evidence": {
      "source_image_url": "",
      "lego_image_url": "",
      "source_image_sha256": null,
      "lego_image_sha256": null,
      "evidence_scope": "front_pair|wide_pair|front_and_wide|multi_view|mixed|unknown",
      "claims_unobserved_surfaces": false
    },
    "annotations": {
      "regions": {
        "head": [
          {
            "feature": "",
            "decision": "",
            "confidence": null,
            "evidence_basis": "",
            "notes": null
          }
        ],
        "torso": [],
        "lower_body": [],
        "accessory_or_silhouette": []
      },
      "identity_critical_features": [],
      "mask_headgear_route": null,

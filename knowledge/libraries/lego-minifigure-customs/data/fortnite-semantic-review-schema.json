  "training_gate": {
    "direct_training_eligibility": "Only records with review_status=adjudicated may be promoted automatically into canonical semantic supervision.",
    "submitted_reviews": "Valid evidence records, but remain review evidence rather than canonical truth.",
    "conflicts": "Preserve all conflicting submitted reviews and route the pair to adjudication; never last-write-wins.",
    "heuristic_policy": "Measurement signals are prioritization/context only and cannot satisfy the adjudication gate."
  }
}

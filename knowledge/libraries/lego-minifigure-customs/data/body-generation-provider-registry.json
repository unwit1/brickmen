        "kinematic_structure",
        "motion_constraints"
      ],
      "native_controls": [
        "inference_configuration"
      ],
      "hardware_notes": [],
      "brickmen_integration": {
        "tier": "post_generation_critic",
        "adapter_mode": "analyze_generated_mesh_and_compare_to_selected_architecture",
        "use_component_slots_for_part_count": false,
        "can_consume_mechanical_geometry_directly": false,
        "pre_generation": [],
        "post_generation": [
          "run on generated visual mesh candidate",
          "compare inferred components/joints to Brickmen expected component slots and skeleton",
          "flag topology or motion disagreements",
          "never overwrite validated Brickmen mechanical records automatically"
        ]
      },
      "limitations": [
        "Not a primary geometry generator.",
        "Articulation predictions require reconciliation with deterministic Brickmen engineering evidence."
      ],
      "execution": {
        "adapter_status": "runnable_cli_verified",
        "entrypoint": "infer.py",
        "invocation": [
          "python",
          "infer.py",
          "--input_mesh",
          "<mesh>",
          "--eval",
          "--output_dir",
          "<output_dir>",
          "--up_dir",
          "Z"
        ],
        "environment": {
          "minimum_vram_gb": null,
          "minimum_vram_authority": "not_verified",
          "cuda_required": true
        }
      },
      "pipeline_stage": "post_generation_critic",
      "output_contract": {
        "kind": "articulation_critic_report",
        "component_slot_mapping": "not_applicable_as_primary_generator",
        "expected_artifacts": [
          "mesh_parts_with_axes_*.glb",
          "animated_textured_*.glb",
          "eval/pred.obj",
          "eval/pred.npz"
        ]
      },
      "upstream_verification": {
        "repository": "https://github.com/RuiningLi/particulate",
        "verified_commit_sha": "dee37a75c449f324d9989993461ee09eaccc1686",
        "verified_on": "2026-09-27",
        "interface_files": [
          "infer.py",
          "configs/particulate-B.yaml"
        ],
        "version_policy": "exact_verified_revision_preferred_reverify_adapter_on_mismatch",
        "verification_scope": "Brickmen execution interface and output contract only; not model quality or production authority"
      }
    },

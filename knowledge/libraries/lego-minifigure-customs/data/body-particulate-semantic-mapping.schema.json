{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "body-particulate-semantic-mapping.schema.json",
  "title": "Brickmen Particulate Semantic Mapping Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "critic_id",
    "architecture_id",
    "global_alignment_candidates",
    "automatic_promotion_allowed",
    "production_geometry_authority"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "critic_id": {
      "const": "particulate"
    },
    "architecture_id": {
      "type": "string"
    },
    "global_alignment_candidates": {
      "type": "array"
    },
    "automatic_promotion_allowed": {
      "const": false
    },
    "production_geometry_authority": {
      "const": false
    }
  }
}

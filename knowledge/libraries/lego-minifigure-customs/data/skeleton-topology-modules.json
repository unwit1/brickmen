      ],
      "applicability": [
        "mechanical",
        "giant",
        "specialized_character"
      ],
      "graph_transform": [
        "remove separate neck-to-head component boundary",
        "retain head landmarks for style/recognition",
        "treat head+torso as one manufacturing component unless architecture revision says otherwise"

      ],
      "replace_component_graph": [
        "mechanical_torso",
        "mechanical_head",
        "left_mechanical_arm",
        "right_mechanical_arm",
        "mechanical_leg_pair"
      ],
      "topology_notes": [
        "No standard humanoid torso/hips assumption.",

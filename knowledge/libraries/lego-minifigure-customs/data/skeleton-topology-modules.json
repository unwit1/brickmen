      "inspired_by": [
        "custom_sidan_full_balljoint_poseable"
      ],
      "applicability": [
        "standard humanoid skeleton"
      ],
      "replace_joint_types": {
        "neck": "ball",
        "shoulder_l": "ball",
        "shoulder_r": "ball",
        "hip_l": "ball",
        "hip_r": "ball"
      },
      "add_nodes": [
        {
          "id": "foot_joint_l",
          "relative_to": "ankle_l",
          "role": "foot_ball_joint"
        },
        {
          "id": "foot_joint_r",
          "relative_to": "ankle_r",
          "role": "foot_ball_joint"
        }
      ],
      "add_joints": [
        {
          "joint_id": "foot_l",

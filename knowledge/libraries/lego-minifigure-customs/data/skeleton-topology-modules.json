    {
      "module_id": "module_torso_shell_overlay",
      "inspired_by": [
        "custom torso/body add-ons"
      ],
      "applicability": [
        "any donor skeleton with unchanged mechanics"
      ],
      "inheritance_rule": "Reuse every node/joint from donor FigureArchitecture; add only a nonmechanical shell envelope.",
      "generation_rule": "Overlay may modify silhouette/relief but cannot enter donor joint keep-outs.",
      "classification": "BodyAugmentation rather than new FigureArchitecture unless underlying joints/components change."
    }

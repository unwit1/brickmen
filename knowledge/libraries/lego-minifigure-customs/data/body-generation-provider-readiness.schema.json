{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "body-generation-provider-readiness.schema.json",
  "title": "Brickmen Body Generation Provider Readiness",
  "type": "object",
  "required": [
    "schema_version",
    "architecture_id",
    "providers",
    "shared_pipeline",
    "physical_blockers",
    "production_geometry_authority"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "architecture_id": {
      "type": "string"
    },
    "providers": {
      "type": "array"
    },
    "shared_pipeline": {
      "type": "object"
    },
    "physical_blockers": {
      "type": "array"
    },
    "production_geometry_authority": {
      "const": false
    }
  }
}
